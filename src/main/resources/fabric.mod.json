{
	"schemaVersion": 1,
	"id": "rotclient",
	"version": "${version}",
	"name": "Rot Client",
	"description": "A modular client-side SkyBlock companion with mining and gemstone tracking, canonical sessions and history, Powder Chest and MOB accounting, configurable HUDs, item information, visual helpers, and an opt-in QoL dashboard.",
	"authors": [
		{
			"name": "RotTools"
		}
	],
	"contact": {
		"homepage": "https://github.com/rot-tools/Rot-Client",
		"sources": "https://github.com/rot-tools/Rot-Client",
		"issues": "https://github.com/rot-tools/Rot-Client/issues"
	},
	"license": "MIT",
	"icon": "assets/rotclient/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"fi.rotclient.RotClientClient"
		],
		"modmenu": [
			"fi.rotclient.RotClientModMenuIntegration"
		]
	},
	"mixins": [
		"rotclient.client.mixins.json",
		"rotclient.compat.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": ">=0.155.2+26.2"
	},
	"suggests": {
		"modmenu": "*"
	},
	"breaks": {
		"miningtracker": "*"
	}
}
